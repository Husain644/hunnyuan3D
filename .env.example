# --- Hunyuan3D 2.1 / 2mv Image->3D API ---
# This is the template. setup.sh copies it to `.env` on first install (and
# never overwrites an existing `.env`). Values marked [setup] are written
# automatically by setup.sh; everything else has a sane default.

# --- GPU / VRAM budgets (GB) ---
# Used by the GPU manager to serialize GPU stages within a single GPU's VRAM.
# The shape stage on 2.1 is not reentrant and needs room; keep quality high.
HY3D_VRAM_GB_SHAPE=11.5
HY3D_VRAM_GB_TEX=11.0
HY3D_VRAM_GB_REMBG=0.5
HY3D_VRAM_GB_RESERVE=1.2

# --- Model checkpoints ---
# The app supports two shape demos: 2.1 (single view) and 2mv (multi-view).
# Weights are served from $HY3DGEN_MODELS (default ./models), downloaded by
# setup.sh via scripts/model_bootstrap.py. Nothing here needs editing.
# [setup] HY3DGEN_MODELS=<abs path to ./models>
# [setup] HY3D_REPO_DIR=<abs path to ./vendor/Hunyuan3D-2.1>

# --- Pipeline behaviour ---
HY3D_ENABLE_TEXTURE=0          # 1 -> texture stage (needs >= 21 GB GPU + rasterizer build)
HY3D_ENABLE_REMBG=0            # 1 -> background removal (extra onnxruntime model)
HY3D_STEPS=30                  # shape diffusion steps (5 for turbo checkpoints)
HY3D_GUIDANCE=5.0
HY3D_OCTREE=256                # mesh resolution 128..384
HY3D_MC_ALGO=mc
HY3D_VAE_CHUNKS=8000           # lower = less peak VRAM during decode
HY3D_TEX_RES=512
HY3D_TEX_VIEWS=6

# --- Server ---
HY3D_HOST=0.0.0.0
HY3D_PORT=8080
HY3D_LOG_LEVEL=info
HY3D_DEBUG=0                   # 1 -> extra logging / dev reload
HY3D_MAX_ACTIVE_JOBS=1         # keep 1: shape stage is not reentrant
HY3D_MAX_UPLOAD_MB=20          # upload size cap (public endpoint rejects > this)
HY3D_CORS_ORIGINS=*            # comma-separated origins, or * to allow all

# --- Storage (relative to CWD unless absolute) ---
HY3D_OUTPUT_DIR=outputs/glb
HY3D_JOB_DIR=outputs/jobs

# --- Optional overrides ---
# HY3D_REPO_DIR=/abs/path/to/Hunyuan3D-2.1   # vendor source (setup.sh sets this)
# HY3DGEN_MODELS=/abs/path/to/models          # checkpoint cache (setup.sh sets this)
# HF_HOME=~/.cache/huggingface                # huggingface_hub metadata cache