HY3D_VRAM_GB_SHAPE=11.5
HY3D_VRAM_GB_TEX=11.0
HY3D_VRAM_GB_REMBG=0.5
HY3D_VRAM_GB_RESERVE=1.2
HY3D_ENABLE_TEXTURE=0          # 1 -> texture stage (needs >= 21 GB GPU + rasterizer build)
HY3D_ENABLE_REMBG=0            # 1 -> background removal (extra onnxruntime model)
HY3D_STEPS=30                  # shape diffusion steps (5 for turbo checkpoints)
HY3D_GUIDANCE=5.0
HY3D_OCTREE=256                # mesh resolution 128..384
HY3D_MC_ALGO=mc
HY3D_VAE_CHUNKS=8000           # lower = less peak VRAM during decode
HY3D_TEX_RES=512
HY3D_TEX_VIEWS=6
HY3D_HOST=0.0.0.0
HY3D_PORT=8081
HY3D_LOG_LEVEL=info
HY3D_DEBUG=0                   # 1 -> extra logging / dev reload
HY3D_MAX_ACTIVE_JOBS=auto
HY3D_MAX_UPLOAD_MB=20          # upload size cap (public endpoint rejects > this)
HY3D_CORS_ORIGINS=*            # comma-separated origins, or * to allow all
HY3D_OUTPUT_DIR=outputs/glb
HY3D_JOB_DIR=outputs/jobs
HY3D_REPO_DIR=/root/hunyuan3d-api/vendor/Hunyuan3D-2.1
HY3DGEN_MODELS=/root/hunyuan3d-api/models