# --- Hunyuan3D 2.1 async API ---
# VRAM budget (GB); the sum across stages may exceed usable T4 (14.6 GB)
# because stages are serialized with CPU offload between them.
HY3D_VRAM_GB_SHAPE=11.5
HY3D_VRAM_GB_TEX=11.0
HY3D_VRAM_GB_REMBG=0.5
HY3D_VRAM_GB_RESERVE=1.2

# Model checkpoints (HF hub) — single repo, shape subfolder inside
HY3D_MODEL_REPO=tencent/Hunyuan3D-2.1
HY3D_SHAPE_MODEL=tencent/Hunyuan3D-2.1
HY3D_SHAPE_SUBFOLDER=hunyuan3d-dit-v2-1
HY3D_PAINT_MODEL=tencent/Hunyuan3D-2.1

# Pipeline behaviour
HY3D_ENABLE_TEXTURE=1          # 0 -> shape-only (faster, ~10 GB peak)
HY3D_ENABLE_REMBG=1            # 0 -> skip background removal
HY3D_STEPS=30                  # shape diffusion steps (5 for turbo checkpoints)
HY3D_GUIDANCE=5.0
HY3D_OCTREE=256                # mesh resolution 128..384
HY3D_MC_ALGO=mc
HY3D_VAE_CHUNKS=8000           # lower = less peak VRAM during decode
HY3D_TEX_RES=512
HY3D_TEX_VIEWS=6

# Server
HY3D_HOST=0.0.0.0
HY3D_PORT=8080
HY3D_MAX_ACTIVE_JOBS=1         # keep 1: shape stage is not reentrant

# Storage (relative to CWD unless absolute)
HY3D_OUTPUT_DIR=outputs/glb
HY3D_JOB_DIR=outputs/jobs

# Colab / repo override (optional — auto-detected; point at the cloned repo)
# HY3D_REPO_DIR=/content/Hunyuan3D-2.1

# Cache dir (default is fine; override for shared Drive cache)
HF_HOME=~/.cache/huggingface
